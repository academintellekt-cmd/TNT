# .env for the standalone Strivex station gateway process that TNT connects
# to over WebSocket (see STRIVEX_WS_PORT / GAME_WS_URL below). This is NOT
# read by TNT itself -- TNT's own runtime config is TNT/.env.example.
#
# Copy this into the gateway process's working directory as `.env` and
# adjust STATION_ID / DATA_DIR / GATEWAY_UI_PORT per station if you run more
# than one gateway on the same machine.

STATION_ID=tnt_01
SERVER_URL=http://192.168.0.239:3000
STATION_KEY=BUbEPf_0-OU6NpLW1oSvjXI1B4gYK7vk
ADAPTER=gameserver
GAME_WS_URL=ws://127.0.0.1:4200
DATA_DIR=C:\Users\demua\AppData\Roaming\tnt-attraction\gateway-data
GATEWAY_UI_PORT=4100
GATEWAY_NFC_ENABLED=true

# TNT is a 2-player duel: both bracelets tap into one lobby before the round
# starts. Without these three, gateway/src/config.js leaves lobbyEnabled
# false (it defaults off) and the round starts on the first tap, charging
# one guest instead of two.
LOBBY_ENABLED=true
LOBBY_MAX_PLAYERS=2
LOBBY_WINDOW_MS=15000

# Caps how long ONE bracelet tap keeps this station unlocked, independent of
# how much time is left on the guest's pass overall.
STATION_SESSION_CAP_SECONDS=120
