{
  "name": "tnt-attraction",
  "version": "2.0.2",
  "author": "academintellekt-cmd",
  "description": "TNT reaction attraction for the StriveX ecosystem",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --test tests/*.test.js",
    "build": "electron-builder --win nsis"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "npmRebuild": false,
    "appId": "ru.strivex.tnt",
    "productName": "TNT Attraction",
    "asar": true,
    "files": ["main.js", "preload.js", "config.json", "public/**/*", "lib/**/*", "package.json"],
    "extraFiles": [{"from": "music", "to": "music"}, {"from": "installer", "to": ".", "filter": ["*.bat", "*.ps1"]}],
    "win": {"target": ["nsis"]},
    "nsis": {"oneClick": false, "perMachine": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "include": "installer/installer.nsh"},
    "artifactName": "TNT-Attraction-Setup-${version}.${ext}"
  }
}
