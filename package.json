{
  "name": "tnt-attraction",
  "version": "2.0.1",
  "author": "academintellekt-cmd",
  "description": "TNT reaction attraction for the StriveX ecosystem",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --test tests/*.test.js",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "electron": "37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "npmRebuild": false,
    "appId": "ru.strivex.tnt",
    "productName": "TNT Attraction",
    "asar": true,
    "files": ["main.js", "preload.js", "config.json", "public/**/*", "lib/**/*", "package.json"],
    "win": {"target": ["portable"]},
    "artifactName": "TNT-Attraction-${version}.${ext}"
  }
}
