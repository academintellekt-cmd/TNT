{
  "name": "tnt-attraction",
  "version": "2.0.5",
  "author": "academintellekt-cmd",
  "description": "TNT reaction attraction for the StriveX ecosystem",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "design": "node scripts/start-design.js",
    "lint": "eslint .",
    "check": "eslint . && node --test tests/*.test.js",
    "check:production-ui": "electron scripts/check-production-ui.js",
    "check:game-modes": "electron scripts/check-game-modes.js",
    "build": "electron-builder --win nsis"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "37.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  },
  "build": {
    "npmRebuild": false,
    "appId": "ru.strivex.tnt",
    "productName": "TNT Attraction",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "config.json",
      "public/**/*",
      "lib/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "music",
        "to": "music"
      },
      {
        "from": "installer",
        "to": ".",
        "filter": [
          "*.bat",
          "*.ps1"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer/installer.nsh"
    },
    "artifactName": "TNT-Attraction-Setup-${version}.${ext}"
  }
}
